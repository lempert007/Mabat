# ---- Database ----
POSTGRES_USER=mabat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mabat
# Used by the backend. In docker-compose the host is "db"; locally use "localhost".
DATABASE_URL=postgresql+asyncpg://mabat:change-me@localhost:5432/mabat

# ---- Backend ----
# Absolute path of the folder the app owns. Models, thumbnails and attachments live here.
MABAT_STORAGE_ROOT=./storage
# Random long string. Used to sign session cookies.
MABAT_SECRET_KEY=replace-with-a-long-random-string
# Largest upload accepted for models / attachments.
MABAT_MAX_UPLOAD_MB=512
# Optional: first editor account, created automatically when the users table is empty.
MABAT_INITIAL_EDITOR_USERNAME=admin
MABAT_INITIAL_EDITOR_PASSWORD=change-me
# Session lifetime in hours (editors and guests).
MABAT_SESSION_HOURS=72
# Set to "true" when served over HTTPS so cookies are marked Secure.
MABAT_SECURE_COOKIES=false
